SIFT_IMAGE=ghcr.io/xboarder56/sift-workstation
# latest = SSH only, desktop = SSH + SIFT GNOME desktop over RDP
SIFT_TAG=latest
SIFT_CONTAINER_NAME=sift-workstation
SIFT_HOSTNAME=sift-workstation
# 127.0.0.1 keeps SSH/RDP local to this host. Use 0.0.0.0 to allow remote
# connections (set a strong password or SSH keys first).
SIFT_BIND_ADDRESS=127.0.0.1
SIFT_SSH_PORT=2222
SIFT_RDP_PORT=3389
SIFT_SHM_SIZE=1gb
# File holding the sansforensics password (mounted as a compose secret).
SIFT_PASSWORD_SECRET=./secrets/sift_password
SIFT_CASES_DIR=./cases
# SIFT_CASE_DIR=./cases/CASE_001
# SIFT_EVIDENCE_DIR=./cases/CASE_001/artifacts
TZ=UTC
TERM=xterm-256color
SIFT_NETWORK_NAME=sift_net
# Static-network values are optional. Uncomment matching blocks in
# docker-compose.example.yml before using these.
# SIFT_IPV4=172.16.0.2
# SIFT_SUBNET=172.16.0.0/16
# SIFT_GATEWAY=172.16.0.1
